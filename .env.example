# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA faça commit do .env — apenas deste .env.example.
# Em produção (Lovable), os valores ficam em Lovable Secrets / Cloud, não em arquivo.

# Supabase / Lovable Cloud (públicos no frontend, prefixados com VITE_)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id

# Equivalentes server-side (lidos por process.env em server functions)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Integrações externas (apenas backend — nunca exponha no frontend)
OPENWEATHER_API_KEY=your_key_here
LOVABLE_API_KEY=your_lovable_ai_gateway_key